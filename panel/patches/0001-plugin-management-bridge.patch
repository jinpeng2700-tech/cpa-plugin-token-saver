+import { describe, expect, test } from 'bun:test';
+import {
+  createPluginManagementBridge,
+  normalizeBridgeError,
+  resolveIframeOrigin,
+  validatePluginManagementHello,
+  validatePluginManagementRequest,
+} from '../src/features/plugins/pluginManagementBridge';
+
+describe('plugin management bridge validation', () => {
+  const dummyWindow = {} as Window;
+  const dummyChildWindow = {
+    postMessage: () => {},
+  } as unknown as Window;
+
+  const validContext = {
+    expectedSource: dummyChildWindow,
+    expectedOrigin: 'https://panel.example.com',
+    pluginId: 'token-saver',
+    inFlightRequestIds: new Set<string>(),
+  };
+
+  test('validates exact valid GET request', () => {
+    const event = {
+      source: dummyChildWindow,
+      origin: 'https://panel.example.com',
+      data: {
+        type: 'cpa.plugin.management.request',
+        version: 1,
+        requestId: 'r1',
+        pluginId: 'token-saver',
+        method: 'GET',
+        path: '/v0/management/plugins/token-saver/dashboard',
+      },
+    };
+
+    const result = validatePluginManagementRequest(event, validContext);
+    expect(result).toEqual({
+      requestId: 'r1',
+      method: 'GET',
+      path: '/v0/management/plugins/token-saver/dashboard',
+      body: undefined,
+    });
+  });
+
+  test('validates exact valid POST request with JSON body', () => {
+    const event = {
+      source: dummyChildWindow,
+      origin: 'https://panel.example.com',
+      data: {
+        type: 'cpa.plugin.management.request',
+        version: 1,
+        requestId: 'r2',
+        pluginId: 'token-saver',
+        method: 'POST',
+        path: '/v0/management/plugins/token-saver/headroom/check',
+        body: { test: true },
+      },
+    };
+
+    const result = validatePluginManagementRequest(event, validContext);
+    expect(result).toEqual({
+      requestId: 'r2',
+      method: 'POST',
+      path: '/v0/management/plugins/token-saver/headroom/check',
+      body: { test: true },
+    });
+  });
+
+  test('rejects hello message as a management request', () => {
+    const event = {
+      source: dummyChildWindow,
+      origin: 'https://panel.example.com',
+      data: {
+        type: 'cpa.plugin.management.hello',
+        version: 1,
+        pluginId: 'token-saver',
+      },
+    };
+
+    expect(validatePluginManagementRequest(event, validContext)).toBeNull();
+  });
+
+  test('rejects wrong event.source', () => {
+    const event = {
+      source: dummyWindow,
+      origin: 'https://panel.example.com',
+      data: {
+        type: 'cpa.plugin.management.request',
+        version: 1,
+        requestId: 'r1',
+        pluginId: 'token-saver',
+        method: 'GET',
+        path: '/v0/management/plugins/token-saver/dashboard',
+      },
+    };
+
+    expect(validatePluginManagementRequest(event, validContext)).toBeNull();
+  });
+
+  test('rejects wrong origin', () => {
+    const event = {
+      source: dummyChildWindow,
+      origin: 'https://evil.example.com',
+      data: {
+        type: 'cpa.plugin.management.request',
+        version: 1,
+        requestId: 'r1',
+        pluginId: 'token-saver',
+        method: 'GET',
+        path: '/v0/management/plugins/token-saver/dashboard',
+      },
+    };
+
+    expect(validatePluginManagementRequest(event, validContext)).toBeNull();
+  });
+
+  test('rejects wrong plugin ID', () => {
+    const event = {
+      source: dummyChildWindow,
+      origin: 'https://panel.example.com',
+      data: {
+        type: 'cpa.plugin.management.request',
+        version: 1,
+        requestId: 'r1',
+        pluginId: 'other-plugin',
+        method: 'GET',
+        path: '/v0/management/plugins/other-plugin/dashboard',
+      },
+    };
+
+    expect(validatePluginManagementRequest(event, validContext)).toBeNull();
+  });
+
+  test('rejects disallowed HTTP methods like PUT, DELETE, PATCH', () => {
+    for (const method of ['PUT', 'DELETE', 'PATCH', 'OPTIONS', 'HEAD', 'get', 'post']) {
+      const event = {
+        source: dummyChildWindow,
+        origin: 'https://panel.example.com',
+        data: {
+          type: 'cpa.plugin.management.request',
+          version: 1,
+          requestId: 'r1',
+          pluginId: 'token-saver',
+          method,
+          path: '/v0/management/plugins/token-saver/dashboard',
+        },
+      };
+
+      expect(validatePluginManagementRequest(event, validContext)).toBeNull();
+    }
+  });
+
+  test('rejects non-plugin path /v0/management/config', () => {
+    const event = {
+      source: dummyChildWindow,
+      origin: 'https://panel.example.com',
+      data: {
+        type: 'cpa.plugin.management.request',
+        version: 1,
+        requestId: 'r1',
+        pluginId: 'token-saver',
+        method: 'GET',
+        path: '/v0/management/config',
+      },
+    };
+
+    expect(validatePluginManagementRequest(event, validContext)).toBeNull();
+  });
+
+  test('rejects sibling plugin namespace path', () => {
+    const event = {
+      source: dummyChildWindow,
+      origin: 'https://panel.example.com',
+      data: {
+        type: 'cpa.plugin.management.request',
+        version: 1,
+        requestId: 'r1',
+        pluginId: 'token-saver',
+        method: 'GET',
+        path: '/v0/management/plugins/other-plugin/dashboard',
+      },
+    };
+
+    expect(validatePluginManagementRequest(event, validContext)).toBeNull();
+  });
+
+  test('rejects path traversal attempts', () => {
+    const event = {
+      source: dummyChildWindow,
+      origin: 'https://panel.example.com',
+      data: {
+        type: 'cpa.plugin.management.request',
+        version: 1,
+        requestId: 'r1',
+        pluginId: 'token-saver',
+        method: 'GET',
+        path: '/v0/management/plugins/token-saver/../config',
+      },
+    };
+
+    expect(validatePluginManagementRequest(event, validContext)).toBeNull();
+  });
+
+  test('rejects query strings in path', () => {
+    const event = {
+      source: dummyChildWindow,
+      origin: 'https://panel.example.com',
+      data: {
+        type: 'cpa.plugin.management.request',
+        version: 1,
+        requestId: 'r1',
+        pluginId: 'token-saver',
+        method: 'GET',
+        path: '/v0/management/plugins/token-saver/dashboard?param=1',
+      },
+    };
+
+    expect(validatePluginManagementRequest(event, validContext)).toBeNull();
+  });
+
+  test('rejects body exceeding 16 KiB', () => {
+    const largeString = 'a'.repeat(16 * 1024 + 1);
+    const event = {
+      source: dummyChildWindow,
+      origin: 'https://panel.example.com',
+      data: {
+        type: 'cpa.plugin.management.request',
+        version: 1,
+        requestId: 'r1',
+        pluginId: 'token-saver',
+        method: 'POST',
+        path: '/v0/management/plugins/token-saver/headroom/check',
+        body: { payload: largeString },
+      },
+    };
+
+    expect(validatePluginManagementRequest(event, validContext)).toBeNull();
+  });
+
+  test('accepts body under or equal to 16 KiB', () => {
+    const exactBody = { payload: 'a'.repeat(100) };
+    const event = {
+      source: dummyChildWindow,
+      origin: 'https://panel.example.com',
+      data: {
+        type: 'cpa.plugin.management.request',
+        version: 1,
+        requestId: 'r1',
+        pluginId: 'token-saver',
+        method: 'POST',
+        path: '/v0/management/plugins/token-saver/headroom/check',
+        body: exactBody,
+      },
+    };
+
+    const result = validatePluginManagementRequest(event, validContext);
+    expect(result).not.toBeNull();
+    expect(result?.body).toEqual(exactBody);
+  });
+
+  test('rejects request containing headers or credentials fields', () => {
+    const headersEvent = {
+      source: dummyChildWindow,
+      origin: 'https://panel.example.com',
+      data: {
+        type: 'cpa.plugin.management.request',
+        version: 1,
+        requestId: 'r1',
+        pluginId: 'token-saver',
+        method: 'GET',
+        path: '/v0/management/plugins/token-saver/dashboard',
+        headers: { Authorization: 'Bearer secret' },
+      },
+    };
+    expect(validatePluginManagementRequest(headersEvent, validContext)).toBeNull();
+
+    const credsEvent = {
+      source: dummyChildWindow,
+      origin: 'https://panel.example.com',
+      data: {
+        type: 'cpa.plugin.management.request',
+        version: 1,
+        requestId: 'r1',
+        pluginId: 'token-saver',
+        method: 'GET',
+        path: '/v0/management/plugins/token-saver/dashboard',
+        authorization: 'Bearer secret',
+      },
+    };
+    expect(validatePluginManagementRequest(credsEvent, validContext)).toBeNull();
+  });
+
+  test('rejects duplicate in-flight request ID', () => {
+    const contextWithInFlight = {
+      ...validContext,
+      inFlightRequestIds: new Set(['r1']),
+    };
+
+    const event = {
+      source: dummyChildWindow,
+      origin: 'https://panel.example.com',
+      data: {
+        type: 'cpa.plugin.management.request',
+        version: 1,
+        requestId: 'r1',
+        pluginId: 'token-saver',
+        method: 'GET',
+        path: '/v0/management/plugins/token-saver/dashboard',
+      },
+    };
+
+    expect(validatePluginManagementRequest(event, contextWithInFlight)).toBeNull();
+  });
+});
+
+describe('plugin management hello validation', () => {
+  const dummyChildWindow = {
+    postMessage: () => {},
+  } as unknown as Window;
+
+  const validContext = {
+    expectedSource: dummyChildWindow,
+    expectedOrigin: 'https://panel.example.com',
+    pluginId: 'token-saver',
+  };
+
+  test('accepts valid hello message', () => {
+    const event = {
+      source: dummyChildWindow,
+      origin: 'https://panel.example.com',
+      data: {
+        type: 'cpa.plugin.management.hello',
+        version: 1,
+        pluginId: 'token-saver',
+      },
+    };
+
+    expect(validatePluginManagementHello(event, validContext)).toBe(true);
+  });
+
+  test('rejects invalid hello messages', () => {
+    expect(
+      validatePluginManagementHello(
+        {
+          source: {} as Window,
+          origin: 'https://panel.example.com',
+          data: { type: 'cpa.plugin.management.hello', version: 1, pluginId: 'token-saver' },
+        },
+        validContext
+      )
+    ).toBe(false);
+
+    expect(
+      validatePluginManagementHello(
+        {
+          source: dummyChildWindow,
+          origin: 'https://evil.example.com',
+          data: { type: 'cpa.plugin.management.hello', version: 1, pluginId: 'token-saver' },
+        },
+        validContext
+      )
+    ).toBe(false);
+
+    expect(
+      validatePluginManagementHello(
+        {
+          source: dummyChildWindow,
+          origin: 'https://panel.example.com',
+          data: { type: 'cpa.plugin.management.hello', version: 1, pluginId: 'other-plugin' },
+        },
+        validContext
+      )
+    ).toBe(false);
+  });
+});
+
+describe('resolveIframeOrigin', () => {
+  test('resolves absolute URL origin', () => {
+    expect(resolveIframeOrigin('https://example.com/some/path')).toBe('https://example.com');
+    expect(resolveIframeOrigin('http://127.0.0.1:8080/v0/resource/plugins/token-saver/page')).toBe(
+      'http://127.0.0.1:8080'
+    );
+  });
+
+  test('resolves relative URL origin against base', () => {
+    expect(
+      resolveIframeOrigin('/v0/resource/plugins/token-saver/page', 'https://cpa.example.com/ui/')
+    ).toBe('https://cpa.example.com');
+  });
+
+  test('returns empty string for invalid or non-http URLs', () => {
+    expect(resolveIframeOrigin('')).toBe('');
+    expect(resolveIframeOrigin('javascript:alert(1)')).toBe('');
+    expect(resolveIframeOrigin('data:text/html,<h1>hi</h1>')).toBe('');
+  });
+});
+
+describe('normalizeBridgeError', () => {
+  test('normalizes error without leaking headers, stack, Axios config, or credentials', () => {
+    const axiosLikeError = {
+      name: 'AxiosError',
+      message: 'Request failed with status code 400',
+      code: 'ERR_BAD_REQUEST',
+      config: { headers: { Authorization: 'Bearer secret-key' }, url: '/v0/management/plugins/token-saver/headroom/check' },
+      response: { status: 400, headers: { 'set-cookie': 'session=secret' }, data: { error: 'invalid_headroom_url', message: 'Headroom URL is unreachable' } },
+      stack: 'Error: Request failed...\n    at Object.<anonymous> (/secret/path/app.ts:1:1)',
+    };
+    const normalized = normalizeBridgeError(axiosLikeError);
