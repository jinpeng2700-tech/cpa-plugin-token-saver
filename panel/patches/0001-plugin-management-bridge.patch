diff --git a/src/features/plugins/pluginManagementBridge.ts b/src/features/plugins/pluginManagementBridge.ts
new file mode 100644
index 0000000..124518c
--- /dev/null
+++ b/src/features/plugins/pluginManagementBridge.ts
@@ -0,0 +1,244 @@
+import { isRecord } from '@/utils/helpers';
+import { parseApiErrorResponse } from '@/services/api/apiError';
+import { apiClient as defaultApiClient } from '@/services/api/client';
+
+export const BRIDGE_MSG_HELLO = 'cpa.plugin.management.hello';
+export const BRIDGE_MSG_READY = 'cpa.plugin.management.ready';
+export const BRIDGE_MSG_REQUEST = 'cpa.plugin.management.request';
+export const BRIDGE_MSG_RESPONSE = 'cpa.plugin.management.response';
+export const MAX_BRIDGE_BODY_BYTES = 16 * 1024;
+
+export interface BridgeContext {
+  expectedSource: Window | null;
+  expectedOrigin: string;
+  pluginId: string;
+  inFlightRequestIds?: Set<string>;
+}
+
+export interface ValidatedBridgeRequest {
+  requestId: string;
+  method: 'GET' | 'POST';
+  path: string;
+  body: unknown;
+}
+
+export interface NormalizedBridgeError {
+  status: number;
+  error: {
+    code: string;
+    message: string;
+  };
+}
+
+export interface BridgeApiClient {
+  get<T = unknown>(path: string): Promise<T>;
+  post<T = unknown>(path: string, body?: unknown): Promise<T>;
+}
+
+export interface BridgeEventTarget {
+  addEventListener(type: 'message', listener: (event: MessageEvent) => void): void;
+  removeEventListener(type: 'message', listener: (event: MessageEvent) => void): void;
+}
+
+export interface CreateBridgeOptions {
+  iframe: HTMLIFrameElement;
+  pluginId: string;
+  expectedOrigin: string;
+  apiClient?: BridgeApiClient;
+  eventTarget?: BridgeEventTarget;
+}
+
+export const resolveIframeOrigin = (iframeSrc: string, baseOrigin?: string): string => {
+  if (!iframeSrc) return '';
+  try {
+    const base = baseOrigin
+      ? baseOrigin
+      : typeof window !== 'undefined' && window.location?.href
+        ? window.location.href
+        : undefined;
+    const parsed = base ? new URL(iframeSrc, base) : new URL(iframeSrc);
+    if (parsed.protocol === 'http:' || parsed.protocol === 'https:') {
+      return parsed.origin;
+    }
+    return '';
+  } catch {
+    return '';
+  }
+};
+
+export const validatePluginManagementHello = (
+  event: {source: unknown; origin: string; data: unknown },
+  context: Pick<BridgeContext, 'expectedSource' | 'expectedOrigin' | 'pluginId'>
+): boolean => {
+  if (!context.expectedSource || event.source !== context.expectedSource) return false;
+  if (!context.expectedOrigin || event.origin !== context.expectedOrigin) return false;
+  if (!isRecord(event.data)) return false;
+  const { type, version, pluginId, ...rest } = event.data;
+  if (type !== BRIDGE_MSG_HELLO || version !== 1 || pluginId !== context.pluginId) return false;
+  if (Object.keys(rest).length > 0) return false;
+  return true;
+};
+
+export const validatePluginManagementRequest = (
+  event: { source: unknown; origin: string; data: unknown },
+  context: BridgeContext
+): ValidatedBridgeRequest | null => {
+  if (!context.expectedSource || event.source !== context.expectedSource) return null;
+  if (!context.expectedOrigin || event.origin !== context.expectedOrigin) return null;
+  if (!isRecord(event.data)) return null;
+  const { type, version, requestId, pluginId, method, path, body, ...rest } = event.data;
+  if (type !== BRIDGE_MSG_REQUEST || version !== 1) return null;
+  if (typeof requestId !== 'string' || !requestId.trim()) return null;
+  if (context.inFlightRequestIds && context.inFlightRequestIds.has(requestId)) return null;
+  if (pluginId !== context.pluginId) return null;
+  if (method !== 'GET' && method !== 'POST') return null;
+  if (typeof path !== 'string') return null;
+  if (Object.keys(rest).length > 0) return null;
+
+  const expectedPrefix = `/v0/management/plugins/${context.pluginId}/`;
+  if (!path.startsWith(expectedPrefix)) return null;
+  if (path.includes('?') || path.includes('#')) return null;
+  if (path.includes('..')) return null;
+
+  if (body !== undefined && body !== null) {
+    try {
+      const serialized = JSON.stringify(body);
+      if (new TextEncoder().encode(serialized).length > MAX_BRIDGE_BODY_BYTES) {
+        return null;
+      }
+    } catch {
+      return null;
+    }
+  }
+
+  return {
+    requestId,
+    method,
+    path,
+    body: body ?? undefined,
+  };
+};
+
+export const normalizeBridgeError = (error: unknown): NormalizedBridgeError => {
+  let status = 500;
+  let code = 'bridge_request_failed';
+  let message = 'Unknown error occurred';
+
+  if (isRecord(error)) {
+    if (typeof error.status === 'number' && error.status >= 400 && error.status < 600) {
+      status = error.status;
+    } else if (isRecord(error.response) && typeof error.response.status === 'number') {
+      status = error.response.status;
+    }
+
+    const responseData = isRecord(error.response) ? error.response.data : error.details ?? error.data;
+    const parsed = parseApiErrorResponse(
+      responseData,
+      typeof error.message === 'string' ? error.message : ''
+    );
+    message = parsed.message || 'Request failed';
+    code =
+      parsed.apiCode ||
+      (typeof error.code === 'string' ? error.code : '') ||
+      'bridge_request_failed';
+  } else if (error instanceof Error) {
+    message = error.message;
+  } else if (typeof error === 'string') {
+    message = error;
+  }
+
+  return {
+    status,
+    error: {
+      code,
+      message,
+    },
+  };
+};
+
+export const createPluginManagementBridge = (options: CreateBridgeOptions): (() => void) => {
+  const { iframe, pluginId, expectedOrigin } = options;
+  const client = options.apiClient || defaultApiClient;
+  const target: BridgeEventTarget | null =
+    options.eventTarget || (typeof window !== 'undefined' ? window : null);
+  let isHandshakeComplete = false;
+  const inFlightRequestIds = new Set<string>();
+
+  if (!target) {
+    return () => {};
+  }
+
+  const handleMessage = async (event: MessageEvent) => {
+    const expectedSource = iframe.contentWindow;
+    if (!expectedSource || event.source !== expectedSource) return;
+    if (!expectedOrigin || event.origin !== expectedOrigin) return;
+
+    if (!isHandshakeComplete) {
+      if (validatePluginManagementHello(event, { expectedSource, expectedOrigin, pluginId })) {
+        isHandshakeComplete = true;
+        expectedSource.postMessage(
+          {
+            type: BRIDGE_MSG_READY,
+            version: 1,
+            pluginId,
+          },
+          expectedOrigin
+        );
+      }
+      return;
+    }
+
+    const request = validatePluginManagementRequest(event, {
+      expectedSource,
+      expectedOrigin,
+      pluginId,
+      inFlightRequestIds,
+    });
+
+    if (!request) return;
+
+    inFlightRequestIds.add(request.requestId);
+    try {
+      let data: unknown;
+      if (request.method === 'GET') {
+        data = await client.get(request.path);
+      } else {
+        data = await client.post(request.path, request.body);
+      }
+
+      expectedSource.postMessage(
+        {
+          type: BRIDGE_MSG_RESPONSE,
+          version: 1,
+          requestId: request.requestId,
+          ok: true,
+          status: 200,
+          data,
+        },
+        expectedOrigin
+      );
+    } catch (err: unknown) {
+      const normalized = normalizeBridgeError(err);
+      expectedSource.postMessage(
+        {
+          type: BRIDGE_MSG_RESPONSE,
+          version: 1,
+          requestId: request.requestId,
+          ok: false,
+          status: normalized.status,
+          data: normalized,
+        },
+        expectedOrigin
+      );
+    } finally {
+      inFlightRequestIds.delete(request.requestId);
+    }
+  };
+
+  target.addEventListener('message', handleMessage);
+
+  return () => {
+    target.removeEventListener('message', handleMessage);
+    inFlightRequestIds.clear();
+  };
+};
