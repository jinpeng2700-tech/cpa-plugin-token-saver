[Unit]
Description=CLIProxyAPI immutable deployment
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/cliproxyapi
Environment=WRITABLE_PATH=/root/cliproxyapi/state
ExecStart=/root/cliproxyapi/cli-proxy-api -config /root/cliproxyapi/state/config.yaml
Restart=on-failure
RestartSec=5s
UMask=0077

[Install]
WantedBy=default.target
