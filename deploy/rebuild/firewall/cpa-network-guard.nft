table inet cpa_network_guard {
    set podman_subnets {
        type ipv4_addr
        flags interval
    }

    chain input {
        type filter hook input priority 10; policy accept;

        iifname "lo" tcp dport { 8317, 8787, 18317, 1455, 54545, 51121 } accept
        ip saddr @podman_subnets tcp dport 8787 accept
        tcp dport { 8317, 8787, 18317, 1455, 54545, 51121 } reject with tcp reset
    }
}
